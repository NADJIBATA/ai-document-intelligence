# =============================================================================
# AI Document Intelligence Platform - configuration
# Copy to .env and adapt:   cp .env.example .env
# NEVER commit the .env file. Generate secrets with:  openssl rand -hex 32
# =============================================================================

# -------------------------------------------------------------- docker compose
# "gpu" starts the local vLLM servers (embeddings + reranker, NVIDIA GPU required).
# Without a GPU: COMPOSE_PROFILES=  (empty), EMBEDDING_PROVIDER=openai,
# EMBEDDING_MODEL=text-embedding-3-small, EMBEDDING_DIMENSION=1536,
# EMBEDDING_BASE_URL=https://api.openai.com/v1, EMBEDDING_API_KEY=<key>, RERANKER_PROVIDER=none
COMPOSE_PROFILES=gpu
# Port of the application on the host: http://localhost (or http://localhost:<port>)
HTTP_PORT=80
# Number of API processes and of parallel jobs of the Celery worker
UVICORN_WORKERS=1
CELERY_CONCURRENCY=2
# Images built locally by default; set registry names to deploy pre-built images
# (e.g. ghcr.io/<owner>/docintel-backend). The tag is APP_VERSION.
BACKEND_IMAGE=docintel-backend
FRONTEND_IMAGE=docintel-frontend

# ----------------------------------------------------------------- application
# development | test | production
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_JSON=true
# Swagger UI at /docs
ENABLE_DOCS=true
CORS_ORIGINS=http://localhost,http://localhost:5173

# ------------------------------------------------------------------ postgresql
POSTGRES_USER=docintel
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=docintel
# Use letters and digits only in the password (it is inserted into a URL).
# docker-compose.yml builds DATABASE_URL from the three values above. Outside Docker:
# DATABASE_URL=postgresql+psycopg://docintel:change-me-postgres@127.0.0.1:5432/docintel
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ----------------------------------------------------------------------- redis
# Set by docker-compose.yml. Outside Docker:
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---------------------------------------------------------------------- qdrant
# QDRANT_URL is set by docker-compose.yml (outside Docker: http://127.0.0.1:6333).
# Optional: when set, Qdrant requires this key and the backend sends it.
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=chunks

# ------------------------------------------------------------- minio (S3 API)
# MINIO_ENDPOINT is set by docker-compose.yml (outside Docker: 127.0.0.1:9000).
# The two keys below are also the MinIO root credentials (secret: 8 characters minimum).
MINIO_ACCESS_KEY=docintel
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=documents
MINIO_SECURE=false

# ------------------------------------------------------------------------ auth
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# false only for local HTTP development; must be true behind HTTPS / in production
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# ---------------------------------------------------------------------- upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,txt,docx

# -------------------------------------------------------------------- chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNK_MIN_SIZE=100

# ------------------------------------------------------------------ embeddings
# vllm   : local GPU server (vllm-embedding service, OpenAI-compatible /v1/embeddings)
# openai : OpenAI embeddings API (fallback without GPU; set EMBEDDING_MODEL accordingly)
# fake   : deterministic vectors, tests only
EMBEDDING_PROVIDER=vllm
EMBEDDING_BASE_URL=http://vllm-embedding:8000/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Output size of EMBEDDING_MODEL (Qwen3-Embedding-0.6B: 1024, text-embedding-3-small: 1536)
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# -------------------------------------------------------------------- reranker
# vllm : local GPU server (vllm-reranker service, /v1/rerank)   none : disabled
RERANKER_PROVIDER=vllm
RERANKER_BASE_URL=http://vllm-reranker:8000
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MIN_SCORE=0.0

# ------------------------------------------------------------- vllm (profile gpu)
# Both servers share one GPU: each one reserves this fraction of the GPU memory.
# 0.40 + 0.40 fits a 4 GB GPU (Qwen3-Embedding-0.6B ~1.2 GB, bge-reranker-v2-m3 ~1.1 GB).
VLLM_EMBEDDING_GPU_MEMORY=0.40
VLLM_RERANKER_GPU_MEMORY=0.40
# Maximum tokens per input (a passage is ~1000 characters, a question <= 2000).
VLLM_MAX_MODEL_LEN=2048
# Only needed for gated models; the default models are public.
HF_TOKEN=

# ------------------------------------------------------------------- retrieval
BM25_TOP_K=30
DENSE_TOP_K=30
RRF_K=60
RRF_MAX_CANDIDATES=60
RERANK_TOP_K=5
BM25_LANGUAGES=fr,en

# ------------------------------------------------------------------------- llm
# openai : any OpenAI-compatible API (OpenAI, Azure OpenAI, Groq, LM Studio...)
# vllm   : vLLM server            -> LLM_BASE_URL=http://vllm-llm:8000/v1
# ollama : Ollama native API      -> LLM_BASE_URL=http://ollama:11434
# fake   : deterministic answers quoted from the passages (tests, demo without a model)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
# Never commit a real key: set it in your local .env or in the deployment secrets.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Token budget of structured outputs (document insights, comparisons)
LLM_STRUCTURED_MAX_TOKENS=3000

# -------------------------------------------------------------- chat / intelligence
CHAT_HISTORY_TURNS=4
MAX_QUESTION_CHARS=2000
# Extract title, summary, entities, dates, amounts... automatically after indexing
INTELLIGENCE_ENABLED=true
INTELLIGENCE_MAX_CHARS_PER_CALL=12000
INTELLIGENCE_MAX_WINDOWS=8
COMPARISON_PASSAGES_PER_ASPECT=3
COMPARISON_MAX_PASSAGES_PER_DOCUMENT=16

# ------------------------------------------------------------------ rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=redis
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_SEARCH=60/minute
RATE_LIMIT_ANALYSIS=10/minute
