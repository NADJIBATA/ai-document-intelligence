# Normalise line endings in the repository; scripts and container files must keep LF
# even on Windows checkouts (a CRLF shell script or nginx template breaks in Linux).
* text=auto
*.sh text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.env.example text eol=lf
