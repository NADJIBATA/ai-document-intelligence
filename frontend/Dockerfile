# syntax=docker/dockerfile:1
# Frontend image: Vite build served as static files by an unprivileged nginx (port 8080).
# The API is not called from here: the edge nginx routes /api to the backend (same origin).

ARG NODE_IMAGE=node:22-alpine
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28-alpine

# ----------------------------------------------------------------------------- build
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
# Exact versions of package-lock.json (versioned, generated by `npm install`).
RUN npm ci --no-audit --no-fund
COPY . .
# Type check + production bundle.
RUN npm run build

# --------------------------------------------------------------------------- runtime
FROM ${NGINX_IMAGE} AS runtime
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
